rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Checks if the requester is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'tyagiaayush3030@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Menu Items: Read by anyone; modified ONLY by admins
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Delivery Zones: Read by anyone; modified ONLY by admins
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders:
    // - Customers (guest or authenticated) can place an order with validated fields
    // - Authenticated users can list/query only their own orders
    // - Guest users with the exact document ID can read (get) their order tracking
    // - Admins have full access to read, update status, and manage all orders
    match /orders/{orderId} {
      // Validate order creation:
      // - Customer name, phone, items list, and non-negative total are strictly required
      // - Item list must be reasonable (1 to 50 items) to prevent resource exhaustion / payload stuffing
      // - Prevents spoofing of other users' UIDs: if authenticated, userId must either match request.auth.uid or be null; if unauthenticated, userId must be null or omitted
      // - Prevents forging final order statuses directly from the client (initial status can only be 'Placed' or 'Preparing')
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.customerName.size() > 0 &&
                       request.resource.data.customerName.size() <= 100 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() >= 10 &&
                       request.resource.data.phone.size() <= 25 &&
                       request.resource.data.total is number &&
                       request.resource.data.total >= 0 &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0 &&
                       request.resource.data.items.size() <= 50 &&
                       (
                         (request.auth == null && (!('userId' in request.resource.data) || request.resource.data.userId == null)) ||
                         (request.auth != null && (!('userId' in request.resource.data) || request.resource.data.userId == null || request.resource.data.userId == request.auth.uid))
                       ) &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'Placed' || request.resource.data.status == 'Preparing');

      // Single document lookup (allows guest order tracking via exact order doc ID)
      allow get: if isAdmin() || 
                    (request.auth != null && (
                      resource.data.userId == request.auth.uid ||
                      (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
                    )) ||
                    resource.data.userId == null;

      // Collection querying / listing (only admins or authenticated owners, preventing data harvesting)
      allow list: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )
      );

      // Check if requester is the customer who placed this order
      function isOrderCustomer() {
        return (request.auth != null && (
          resource.data.userId == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email)
        )) || resource.data.userId == null;
      }

      // Ensure critical financial, item, customer, and timestamps cannot be tampered with
      function areCoreFieldsUnchanged() {
        return request.resource.data.total == resource.data.total &&
               request.resource.data.items == resource.data.items &&
               request.resource.data.subtotal == resource.data.subtotal &&
               request.resource.data.taxes == resource.data.taxes &&
               request.resource.data.deliveryFee == resource.data.deliveryFee &&
               request.resource.data.orderNumber == resource.data.orderNumber &&
               request.resource.data.customerName == resource.data.customerName &&
               request.resource.data.phone == resource.data.phone &&
               request.resource.data.paymentMethod == resource.data.paymentMethod &&
               request.resource.data.createdAt == resource.data.createdAt;
      }

      // Safe customer cancellation:
      // - Customer can ONLY cancel while status is still 'Placed' (before kitchen prep starts)
      // - Status must transition to 'Cancelled'
      // - cancelledBy must be 'customer'
      // - cancelledAt must be a valid timestamp
      // - cancelReason is optional string (max 300 chars)
      // - Financial and item data remain completely frozen
      function isValidCustomerCancellation() {
        return isOrderCustomer() &&
               resource.data.status == 'Placed' &&
               request.resource.data.status == 'Cancelled' &&
               request.resource.data.cancelledBy == 'customer' &&
               request.resource.data.cancelledAt is number &&
               (!('cancelReason' in request.resource.data) || (
                 request.resource.data.cancelReason is string &&
                 request.resource.data.cancelReason.size() <= 300
               )) &&
               areCoreFieldsUnchanged();
      }

      // Safe customer rating & feedback:
      // - Customer can ONLY rate fulfilled/delivered orders
      // - Status MUST stay 'Delivered' (cannot change)
      // - rating must be a valid score between 1 and 5
      // - feedbackAt must be a valid timestamp
      // - feedbackComment is optional string (max 600 chars)
      // - feedbackTags is optional list (max 10 items)
      // - Financial, item, and customer data remain completely frozen
      function isValidCustomerFeedback() {
        return isOrderCustomer() &&
               resource.data.status == 'Delivered' &&
               request.resource.data.status == 'Delivered' &&
               request.resource.data.rating is number &&
               request.resource.data.rating >= 1 &&
               request.resource.data.rating <= 5 &&
               request.resource.data.feedbackAt is number &&
               (!('feedbackComment' in request.resource.data) || (
                 request.resource.data.feedbackComment is string &&
                 request.resource.data.feedbackComment.size() <= 600
               )) &&
               (!('feedbackTags' in request.resource.data) || (
                 request.resource.data.feedbackTags is list &&
                 request.resource.data.feedbackTags.size() <= 10
               )) &&
               areCoreFieldsUnchanged();
      }

      // Authorized admins can manage all fields; customers can only cancel or provide feedback within strict security bounds
      allow update: if isAdmin() || isValidCustomerCancellation() || isValidCustomerFeedback();
      allow delete: if isAdmin();
    }
    
    // Reservations:
    // - Customers can submit reservations with valid structure
    // - Only admins can view, update, or cancel reservations
    match /reservations/{reservationId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 100 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() >= 10 &&
                       request.resource.data.phone.size() <= 25 &&
                       request.resource.data.date is string &&
                       request.resource.data.guests is number &&
                       request.resource.data.guests >= 1 &&
                       request.resource.data.guests <= 50 &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow read, update, delete: if isAdmin();
    }

    // Admins Whitelist:
    // - Only the designated Super Admin (tyagiaayush3030@gmail.com) can add or remove admins
    // - Authenticated users can check if their own ID/email exists in the admin list
    // - Listing all admins requires already being an authorized admin
    match /admins/{adminId} {
      allow get: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == adminId ||
          request.auth.token.email == adminId
        )
      );
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.token.email == 'tyagiaayush3030@gmail.com';
    }

    // Restaurant Settings (operating hours, fees, taxes):
    // - Read by anyone so customer frontend functions properly
    // - Modified ONLY by admins
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

